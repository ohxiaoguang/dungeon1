# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
.gui-build/
# Local agent notes for this workspace (project skills under .workbuddy/skills/ stay tracked)
.workbuddy/memory/
gui/.build/
gui/.swiftpm/
__pycache__/
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# The chain version header is global (dm/gfx/nvn/dmsh_chain.h), never per game
dm/games/*/dmsh_chain.h


